# ---- App ----
APP_URL=http://localhost:3000
SESSION_COOKIE=appolo_session
NODE_ENV=development

# ---- Database ----
# Application role: NOT a superuser, so row-level security is enforced.
DATABASE_URL=postgresql://appolo_app:appolo_dev_password@127.0.0.1:55432/appolo

# Migration/seed role: superuser/owner, bypasses RLS for DDL and fixtures.
MIGRATE_DATABASE_URL=postgresql://appolo@127.0.0.1:55432/appolo

# ---- Queues (optional in Phase 0) ----
# Leave empty to run without Redis. The worker idles cleanly.
REDIS_URL=

# ---- SMS provider (Phase 1) ----
# Leave empty to use the built-in mock adapter. When all three are set, the
# Twilio REST adapter is used and webhook signatures are verified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Demo seed ----
SEED_EMAIL=owner@appolo.test
SEED_PASSWORD=appolo-demo-1234