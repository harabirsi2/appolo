# ---- App ----
APP_URL=http://localhost:3000
SESSION_COOKIE=appolo_session

# ---- Database ----
# Application role: NOT a superuser, so row-level security is enforced.
DATABASE_URL=postgresql://appolo_app:appolo_dev_password@127.0.0.1:55432/appolo

# Migration/seed role: superuser/owner, bypasses RLS for DDL and fixtures.
MIGRATE_DATABASE_URL=postgresql://appolo@127.0.0.1:55432/appolo

# ---- Queues (optional in Phase 0) ----
# Leave empty to run without Redis. The worker idles cleanly.
REDIS_URL=

# ---- SMS provider (Phase 1) ----
# Leave empty to use the built-in mock adapter in development and test. When all
# three are set, the Twilio REST adapter is used and webhook signatures are
# verified. In production, an unconfigured provider fails loudly and unsigned
# webhooks are refused unless the override below is set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Production escape hatches (never set these in a real deployment):
# TWILIO_ALLOW_UNSIGNED_WEBHOOKS=true
# ALLOW_MOCK_PROVIDERS=true

# ---- Email provider (Phase 2) ----
# Leave empty to use the built-in mock adapter. When both are set, the Resend
# REST adapter sends real email.
RESEND_API_KEY=
EMAIL_FROM="Appolo <reviews@yourdomain.com>"

# ---- Google Business Profile (Phase 2) ----
# OAuth access token with the Business Profile API scope. Without it, a full
# sync skips Google and other platforms use the demo adapter.
GOOGLE_BUSINESS_ACCESS_TOKEN=

# ---- Web chat widget ----
# HMAC key for the visitor token the widget must present to read its own
# transcript. At least 32 characters; required in production (the route fails
# closed without it). Outside production a fixed development secret is used.
# Generate one with: openssl rand -base64 48
WEBCHAT_TOKEN_SECRET=

# ---- Demo seed ----
# Opt-in only. Without SEED_DEMO=1 the seed still creates the shared catalog and
# the public tour profile (/demo), but creates no account and no password.
# The visual/a11y suites sign in as the demo account, so they need this set.
SEED_DEMO=
SEED_EMAIL=owner@appolo.test
# Leave blank to use the development-only default (printed by the seed).
SEED_PASSWORD=
