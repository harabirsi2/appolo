{
  "name": "appolo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32",
      "zod": "4.6.7"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @appolo/web --filter @appolo/worker dev",
    "dev:web": "pnpm --filter @appolo/web dev",
    "dev:worker": "pnpm --filter @appolo/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @appolo/core test",
    "test:imports": "pnpm --filter @appolo/db exec tsx --tsconfig ../../apps/web/tsconfig.json --test --test-force-exit ../../apps/web/lib/services/importers.test.ts",
    "test:moderation": "pnpm --filter @appolo/db exec tsx --tsconfig ../../apps/web/tsconfig.json --test --test-force-exit ../../apps/web/lib/services/moderation.test.ts",
    "test:ranking": "pnpm --filter @appolo/db exec tsx --tsconfig ../../apps/web/tsconfig.json --test --test-force-exit ../../apps/web/lib/services/ranking-math.test.ts",
    "test:undo": "pnpm --filter @appolo/db exec tsx --tsconfig ../../apps/web/tsconfig.json --test --test-force-exit ../../apps/web/lib/services/rankings-undo.test.ts",
    "audit": "pnpm audit --prod --audit-level=low",
    "db:generate": "pnpm --filter @appolo/db generate",
    "db:migrate": "pnpm --filter @appolo/db migrate",
    "db:seed": "pnpm --filter @appolo/db seed",
    "db:rls-test": "pnpm --filter @appolo/db rls-test",
    "db:idempotency-test": "pnpm --filter @appolo/db idempotency-test",
    "db:reset": "pnpm --filter @appolo/db reset",
    "db:up": "powershell -ExecutionPolicy Bypass -File scripts/dev-db.ps1",
    "db:down": "powershell -ExecutionPolicy Bypass -File scripts/dev-db.ps1 -Stop",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "e2e": "node scripts/e2e.mjs",
    "gap-audit": "node scripts/gap-audit.mjs",
    "preflight": "node scripts/preflight.mjs",
    "db:role-guard": "pnpm --filter @appolo/db role-guard",
    "visual": "node scripts/visual.mjs",
    "visual:local": "node scripts/visual.mjs --local",
    "visual:local:accept": "node scripts/visual.mjs --local --update",
    "media-art": "node scripts/media-art.mjs",
    "verify": "pnpm preflight && pnpm db:role-guard && pnpm media-art && pnpm typecheck && pnpm lint && pnpm test && pnpm test:imports && pnpm test:moderation && pnpm test:signals && pnpm test:ranking && pnpm test:undo && pnpm test:concurrency && pnpm visual && pnpm e2e && pnpm gap-audit",
    "ci": "powershell -ExecutionPolicy Bypass -File scripts/ci.ps1",
    "a11y": "node scripts/a11y.mjs",
    "lint": "eslint .",
    "test:concurrency": "pnpm --filter @appolo/db exec tsx --tsconfig ../../apps/web/tsconfig.json --test --test-force-exit ../../apps/web/lib/services/rankings-concurrency.test.ts",
    "test:signals": "pnpm --filter @appolo/db exec tsx --tsconfig ../../apps/web/tsconfig.json --test --test-force-exit ../../apps/web/lib/services/moderation-signals.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "6",
    "eslint-plugin-react-hooks": "5",
    "globals": "15",
    "pixelmatch": "6.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8"
  }
}
